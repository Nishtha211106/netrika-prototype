%% ===== runQualityPipeline.m (5-class version) =====

imds = imageDatastore('../data/sample_images', ...
    'IncludeSubfolders', true, 'LabelSource', 'foldernames');

fprintf('Found %d images across %d classes\n', numel(imds.Files), numel(categories(imds.Labels)));

outputFolder = 'processed_output';
if ~exist(outputFolder, 'dir')
    mkdir(outputFolder);
end

% Create matching class subfolders in output
classNames = categories(imds.Labels);
for c = 1:numel(classNames)
    classFolder = fullfile(outputFolder, classNames{c});
    if ~exist(classFolder, 'dir')
        mkdir(classFolder);
    end
end

results = table('Size',[0 6], ...
    'VariableTypes',{'string','string','double','double','double','string'}, ...
    'VariableNames',{'Filename','Class','FocusScore','MeanIntensity','FOVRatio','Status'});

borderlinePairs = {};
gradeablePairs = {};

for i = 1:numel(imds.Files)
    img = readimage(imds, i);
    [~, name, ext] = fileparts(imds.Files{i});
    classLabel = string(imds.Labels(i));   % '0', '1', '2', '3', or '4'

    q = assessQuality(img);

    switch q.status
        case 'gradeable'
            outImg = lightEnhance(img);
            gradeablePairs{end+1} = img;
            gradeablePairs{end+1} = outImg;
        case 'borderline'
            outImg = enhanceImage(img);
            borderlinePairs{end+1} = img;
            borderlinePairs{end+1} = outImg;
        case 'reject'
            outImg = [];
    end

    if ~isempty(outImg)
        savePath = fullfile(outputFolder, classLabel, [char(name) char(ext)]);
        imwrite(outImg, savePath);
    end

    results = [results; {string(name)+string(ext), classLabel, q.focusScore, q.meanIntensity, q.fovRatio, string(q.status)}];
    fprintf('%d/%d: [class %s] %s -> %s\n', i, numel(imds.Files), classLabel, name, q.status);
end

writetable(results, 'quality_report.csv');

% ===== Summary counts =====
numGradeable  = numel(gradeablePairs)/2;
numBorderline = numel(borderlinePairs)/2;
numReject     = sum(results.Status == "reject");

fprintf('\n--- Summary ---\n');
fprintf('Gradeable images (light enhanced): %d\n', numGradeable);
fprintf('Borderline images (full enhanced): %d\n', numBorderline);
fprintf('Rejected images: %d\n', numReject);
fprintf('Total sent to processed_output: %d\n', numGradeable + numBorderline);

% ===== Per-class breakdown (new) =====
fprintf('\n--- Per-Class Breakdown ---\n');
for c = 1:numel(classNames)
    classResults = results(results.Class == classNames{c}, :);
    fprintf('Class %s: %d gradeable, %d borderline, %d reject\n', ...
        classNames{c}, ...
        sum(classResults.Status == "gradeable"), ...
        sum(classResults.Status == "borderline"), ...
        sum(classResults.Status == "reject"));
end

% ===== Visualizations =====
if numBorderline > 0
    figure;
    montage(borderlinePairs, 'Size', [numBorderline, 2]);
    title('BORDERLINE: Left = Original | Right = Enhanced');
end

if numGradeable > 0
    figure;
    montage(gradeablePairs, 'Size', [numGradeable, 2]);
    title('GRADEABLE: Left = Original | Right = Lightly Enhanced');
end

disp('Done!');